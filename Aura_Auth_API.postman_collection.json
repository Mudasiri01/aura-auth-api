            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\",\n  \"daysToAdd\": 30\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/extend-subscription", "host": ["{{baseUrl}}"], "path": ["api", "admin", "extend-subscription"] }
          }
        },
