            },
            "url": { "raw": "{{baseUrl}}/api/admin/deactivate-subscription", "host": ["{{baseUrl}}"], "path": ["api", "admin", "deactivate-subscription"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reset-password"] }
          }
        },
        {
          "name": "Change Device Limit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\",\n  \"limit\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/change-device-limit", "host": ["{{baseUrl}}"], "path": ["api", "admin", "change-device-limit"] }
          }
        },
        {
          "name": "Reset Devices",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/reset-devices", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reset-devices"] }
          }
        },
        {
          "name": "Delete Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\",\n  \"deviceId\": \"machine-uuid-123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/delete-device", "host": ["{{baseUrl}}"], "path": ["api", "admin", "delete-device"] }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/delete-user", "host": ["{{baseUrl}}"], "path": ["api", "admin", "delete-user"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "jwtToken", "value": "your_jwt_token_here", "type": "string" },
    { "key": "adminToken", "value": "your_admin_jwt_token_here", "type": "string" }
  ]
}
