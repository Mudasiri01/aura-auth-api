            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user_id_here\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/activate-subscription", "host": ["{{baseUrl}}"], "path": ["api", "admin", "activate-subscription"] }
          }
        },
        {
          "name": "Extend Subscription",
